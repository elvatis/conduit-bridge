# conduit-bridge .env - copy to `.env` and fill in the keys you use.
#
# Loaded from a `.env` in the directory you run the bridge from, then from
# `~/.conduit/.env`. Real environment variables always take precedence, and an
# earlier file wins over a later one. Keys can also be stored (non-.env) via:
#   conduit-bridge config apiKeys.<provider> <key>

# OpenRouter - enables api-openrouter/* models. Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Perplexity - enables api-perplexity/* models (sonar* + proxied upstreams)
PERPLEXITY_API_KEY=pplx-...

# Direct API providers (optional; use independent API keys).
# CLI login credentials are owned by the corresponding CLI and are not API keys.
# .env is plaintext configuration, not encrypted secret storage. Never commit it.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
# GOOGLE_API_KEY=          # alternative to GEMINI_API_KEY
OPENAI_API_KEY=

# LM Studio server URL (default http://127.0.0.1:1234). No API key needed.
LM_STUDIO_URL=http://127.0.0.1:1234

# BitNet CPU inference: https://github.com/microsoft/BitNet
# Complete installation and first-answer checks: docs/guides/bitnet.md
# The BitNet build supplies llama-server; model weights are a separate download.
BITNET_URL=http://127.0.0.1:8080
# Absolute path to an installed GGUF model; models are never downloaded automatically.
BITNET_MODEL_PATH=
# Native llama-server binary built from BitNet (name or absolute path).
BITNET_SERVER_BINARY=llama-server
# For Microsoft's b1.58 2B-4T GGUF: set llama-bpe and the absolute path to
# scripts/bitnet/chat-2b4t.jinja. These complement the helper's native build patch.
BITNET_TOKENIZER_PRE=
BITNET_CHAT_TEMPLATE_PATH=
# Automatic startup settings; the model path above must be configured first.
BITNET_AUTOSTART=true
BITNET_THREADS=2
BITNET_CTX_SIZE=2048

# tgrep: https://github.com/microsoft/tgrep
# Current upstream uses TCP JSON-RPC and selects a port automatically.
# Leave URL empty for per-workspace discovery. Example: tcp://127.0.0.1:7700
TGREP_URL=
TGREP_BINARY=tgrep
# Optional directory inside the active workspace; empty uses the workspace root.
TGREP_INDEX_PATH=

# Optional notification delivery. HTTPS POST {"message":"..."}; default is log-only.
CONDUIT_NOTIFY_WEBHOOK_URL=
